# Másold .env fájlba, és töltsd ki. A .env NEM kerülhet verziókezelésbe.

# PostgreSQL kapcsolat (helyi fejlesztéshez a felhő környezet setup scriptje hozza létre)
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking_dev
# Csak tesztekhez (npm test) — külön adatbázis, a tesztek törlik a tartalmát!
TEST_DATABASE_URL=postgresql://booking:booking@localhost:5432/booking_test

# Az oldal nyilvános címe (e-mailekben, iCal-linkekben, canonical URL-ben)
APP_URL=http://localhost:3000

# Hosszú, véletlen titok (pl. `openssl rand -hex 32`) — tokenek aláírásához
APP_SECRET=change-me-to-a-long-random-string

# Időzített feladatok (lejárt zárolások, iCal-import) hívásához
CRON_SECRET=change-me-too

# E-mail: "outbox" = csak adatbázisba ír (fejlesztés/demó); "smtp" = valódi küldés
EMAIL_DRIVER=outbox
EMAIL_FROM="[PLACEHOLDER: feladó neve] <[PLACEHOLDER: feladó e-mail]>"
EMAIL_ADMIN_TO=[PLACEHOLDER: értesítési e-mail cím]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Fizetés: jelenleg csak "manual" (átutalás / helyszíni, admin rögzíti). Stripe/Barion/SimplePay: integrációra vár.
PAYMENT_PROVIDER=manual

# Foglalási zárolás időtartama percben
BOOKING_HOLD_MINUTES=15
